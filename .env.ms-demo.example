# Connection from Docker containers to the SQL Server already running on the host.
# For Podman, host.containers.internal may be the right host name instead.
MS_DEMO_SQLSERVER_SERVER=host.docker.internal
MS_DEMO_SQLSERVER_PORT=1433
MS_DEMO_SQLSERVER_DATABASE=dispatcherd
MS_DEMO_SQLSERVER_USER=sa
MS_DEMO_SQLSERVER_PASSWORD=
MS_DEMO_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
MS_DEMO_SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
MS_DEMO_SQLSERVER_CONNECT_TIMEOUT_SECONDS=15
MS_DEMO_SQLSERVER_QUERY_TIMEOUT_SECONDS=30
